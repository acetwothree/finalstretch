# FinishLine — environment

# --- Anthropic API key (used server-side for every visitor's scan) ---
# Put YOUR key here. This is checked before ANTHROPIC_API_KEY, so it wins even
# if a stale ANTHROPIC_API_KEY is exported in your shell.
FINISHLINE_ANTHROPIC_API_KEY=

# Fallback if the above is unset.
ANTHROPIC_API_KEY=

# --- Models (optional overrides) ---
# FINISHLINE_SCAN_MODEL=claude-haiku-4-5     # free scan / brief — cheapest
# FINISHLINE_PLAN_MODEL=claude-sonnet-5      # paid plan + "make the change"

# --- Soft password gate ---
# Set this on your PUBLIC host so only people with the password can use the site
# (the in-app paywall is a simulation and can be bypassed — see README hosting).
# Leave it BLANK for local dev.
SITE_PASSWORD=

# Without an API key the whole flow still works on built-in demo data.
